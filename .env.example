# Salin ke .env (jangan di-commit). Jangan isi rahasia: broker HiveMQ publik tidak privat.
# PROJECT_ID: huruf/angka/underscore, unik per tim. Ganti placeholder, mis. kelas_iot_siagarob_07.
PROJECT_ID=GANTI_DENGAN_ID_UNIK_TIM
MQTT_HOST=broker.hivemq.com
MQTT_PORT=1883

# Dashboard (Next.js) - salin juga ke dashboard/.env.local
NEXT_PUBLIC_PROJECT_ID=GANTI_DENGAN_ID_UNIK_TIM
NEXT_PUBLIC_MQTT_WS_URL=wss://broker.hivemq.com:8884/mqtt
NEXT_PUBLIC_ADAPTER_URL=http://localhost:8000

